exports[`buildRenderPlan mixes narration into an xfade join after the clip inputs 1`] = `
[
  "-nostdin",
  "-y",
  "-i",
  "/work/clip-0.mp4",
  "-i",
  "/work/clip-1.mp4",
  "-i",
  "/media/voice-1.m4a",
  "-filter_complex",
  "[0:v][1:v]xfade=transition=fade:duration=1.000:offset=3.000[v1];[0:a][1:a]acrossfade=d=1.000[a1];[2:a]atrim=0.000:4.000,asetpts=PTS-STARTPTS,volume=1,adelay=1500|1500[n0];[a1][n0]amix=inputs=2:normalize=0:dropout_transition=0,apad,atrim=0:9.000[a]",
  "-map",
  "[v1]",
  "-map",
  "[a]",
  "-fps_mode",
  "cfr",
  "-r",
  "30",
  "-c:v",
  "libx264",
  "-preset",
  "medium",
  "-crf",
  "20",
  "-g",
  "60",
  "-keyint_min",
  "60",
  "-sc_threshold",
  "0",
  "-pix_fmt",
  "yuv420p",
  "-c:a",
  "aac",
  "-b:a",
  "128k",
  "-movflags",
  "+faststart",
  "/work/out.mp4",
]
`;

